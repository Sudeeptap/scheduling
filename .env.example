# Doctor's Assistant -- environment variables
# Copy this file to .env and fill in the values before running the backend.
# NEVER commit .env to source control.

# Required: OpenAI API key (get one at https://platform.openai.com/api-keys)
OPENAI_API_KEY=your-openai-api-key-here

# Optional: OpenAI model to use. Defaults to gpt-4o if not set.
OPENAI_MODEL=gpt-4o

# Optional: SQLite database file path. Defaults to ./clinic.db if not set.
DATABASE_URL=./clinic.db

# Required: IANA timezone identifier for the clinic's local timezone.
# Examples: Asia/Kolkata, America/New_York, Europe/London, Asia/Singapore
# Do NOT use offset strings like UTC+5:30 -- they are not valid IANA identifiers.
CLINIC_TIMEZONE=Asia/Kolkata